# Copy this file to server/.env and fill in your values

# Database Configuration
MONGO_URI=mongodb://localhost:27017/iotBlockchain
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/iotBlockchain

# Blockchain Configuration
RPC_URL=http://127.0.0.1:8545
# For testnet: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# For mainnet: https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Smart Contract
PRIVATE_KEY=your_ganache_private_key_here
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Server Configuration
PORT=5000

# Optional: Weather API (uses free tier)
WEATHER_API_KEY=your_openweather_api_key_here